  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0.0"
        },
        "eventVersion": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "type": {
          "enum": [
            "interactive-project/activity.created",
            "interactive-project/activity.started",
            "interactive-project/activity.resumed",
            "interactive-project/activity.interacted",
            "interactive-project/activity.completed",
            "interactive-project/activity.failed",
            "interactive-project/attempt.started",
            "interactive-project/attempt.submitted",
            "interactive-project/answer.changed",
            "interactive-project/answer.submitted",
            "interactive-project/hint.requested",
            "interactive-project/code.executed",
            "interactive-project/diagram.nodeCreated",
            "interactive-project/whiteboard.objectCreated",
            "interactive-project/simulation.started",
            "interactive-project/simulation.paused",
            "interactive-project/simulation.resumed",
            "interactive-project/simulation.stopped",
            "interactive-project/simulation.parameterChanged"
          ]
        },
        "activityId": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "activityType": {
          "type": "string",
          "enum": [
            "interactive-project/quiz",
            "interactive-project/flashcards",
            "interactive-project/code",
            "interactive-project/simulation",
            "interactive-project/diagram",
            "interactive-project/whiteboard"
          ]
        },
        "sessionId": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "attemptId": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sourceId": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds captured by the host; not a globally ordered clock."
        },
        "causationEventId": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "causationActionId": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "correlationId": {
          "type": "string",
          "description": "Stable lowercase UUIDv4 identifying the logical activity.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "payload": {
          "type": "object"
        },
        "extensions": {
          "type": "object",
          "description": "Optional namespaced extension values. Unknown extensions are ignored semantically and preserved.",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+/[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "https://github.com/interactive-project/protocol/blob/main/schemas/activity-spec.v1.schema.json#/$defs/jsonValue"
          }
        }
      },
      "required": [
        "protocolVersion",
        "eventVersion",
        "id",
        "type",
        "activityId",
        "activityType",
        "sessionId",
        "sourceId",
        "sequence",
        "timestamp",
        "payload"
      ],
      "additionalProperties": false
    }
  }
}
